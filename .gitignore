# 本地平台凭据（绝不入库；推荐落点其实是 ~/.workbuddy/secrets/）
.credentials.local.json
*.credentials.json

# 本机技能克隆路径映射（含绝对路径 / 用户目录，勿入库；模板见 docs/repos.example.json）
docs/repos.json

# 本机技能扫描配置（路径 / 排除名单；模板见 .env.example）
.env
.env.local


# Python 字节码
__pycache__/
*.pyc

# 依赖隔离虚拟环境（setup_env.py 默认建在 tools/.venv，不进版本库）
tools/.venv/
